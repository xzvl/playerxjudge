# ============================================================
# Supabase (required)
# Project Settings -> API in your Supabase dashboard
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. NEVER prefix with NEXT_PUBLIC_, never send to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ============================================================
# Site
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============================================================
# Google OAuth (configured in Supabase Auth providers, not read
# directly by the app, but documented here for setup reference)
# ============================================================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ============================================================
# Resend (transactional email)
# ============================================================
RESEND_API_KEY=

# ============================================================
# Payments (architecture placeholders — see README "Payments")
# ============================================================
GCASH_MERCHANT_ID=
MAYA_PUBLIC_KEY=
MAYA_SECRET_KEY=
BANK_TRANSFER_ACCOUNT_DETAILS=

# Future: Stripe / PayMongo
STRIPE_SECRET_KEY=
PAYMONGO_SECRET_KEY=

# ============================================================
# Vercel Analytics is enabled automatically on Vercel deployments;
# no env var required.
# ============================================================
